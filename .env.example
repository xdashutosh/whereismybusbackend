# ─────────────────────────────────────────────────────────────────────────────
# Where Is My Bus — backend environment template (placeholders only, never real values).
# Copy to backend/.env and fill in. Precedence: real environment variables >
# backend/.env.local (git-ignored local overrides) > backend/.env.  (contract §13)
# ─────────────────────────────────────────────────────────────────────────────
# development | production | test. `npm start` / `npm run start:worker` force production.
NODE_ENV=development
PORT=4000
# A non-production API/worker refuses to boot against a non-local database. Set true only to
# accept that deliberately (e.g. a shared staging DB).
ALLOW_REMOTE_DEV_DB=false

# Comma-separated allowed CORS origins (required in production; empty = allow all in dev).
# Production: the Vercel origin(s), e.g. https://whereismybus.vercel.app — REST calls arrive same-origin
# through the Vercel /api rewrite, but Socket.IO connects to Render directly and needs it
# (docs/DEPLOY_VERCEL_RENDER.md). Bare origins only (scheme + host [+ port]), comma-separated.
CORS_ORIGINS=http://localhost:5173
# Optional extra origins as anchored regexes, space-separated (production: must start with ^https://),
# e.g. Vercel previews: ^https://whereismybus-[a-z0-9-]+-yourteam\.vercel\.app$
CORS_ORIGIN_PATTERNS=
APP_PUBLIC_URL=http://localhost:5173
# false | true | <hop count> | <comma-separated proxy addresses/subnets>
# Production on Render (with or without the Vercel rewrite, or custom domains): 1 — Render's proxy only.
# Never more: direct callers could then choose their own IP with X-Forwarded-For.
TRUST_PROXY=false

# ── Database: OWNER role (migrations, seeds, db:setup-roles) ─────────────────
# DATABASE_URL, when set, overrides the DB_* values.
DATABASE_URL=
DB_HOST=your-db-host.example.com
DB_PORT=5432
DB_USER=your_owner_role
DB_PASSWORD=change-me
DB_NAME=whereismybus
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
# ── Database: APP role (runtime API + worker; LOGIN NOBYPASSRLS, created by npm run db:setup-roles)
# DATABASE_APP_URL, when set, overrides the owner location + DB_APP_USER/DB_APP_PASSWORD.
DATABASE_APP_URL=
DB_APP_USER=wimb_app
DB_APP_PASSWORD=change-me-too
# ── Test database (same server; the name must contain "test") ─────────────────
TEST_DB_NAME=whereismybus_test
TEST_DATABASE_URL=
TEST_DATABASE_APP_URL=

# ── Object storage (S3-compatible, Linode; the bucket may be shared) ──────────
AWS_REGION=in-maa-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_BUCKET_NAME=your-bucket
S3_PROVIDER=linode
S3_ENDPOINT=https://in-maa-1.linodeobjects.com
# Every object key written by this app starts with this prefix.
S3_KEY_PREFIX=whereismybus/
# s3 | local  (local = files under backend/storage/, refused in production; tests always use it)
STORAGE_DRIVER=s3
# Optional root folder of the local driver (absolute or relative to backend/); default backend/storage.
STORAGE_LOCAL_DIR=

# ── Auth ─────────────────────────────────────────────────────────────────────
# Keep it stable: it also derives the key that encrypts TOTP secrets — changing it locks out every
# enrolled Super Admin. Rotate token signing with JWT_ACCESS_KEYS / JWT_ACTIVE_KID instead.
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# Optional key rotation: kid:secret pairs (comma-separated, each secret >= 32 chars) or a JSON object,
# plus the kid that signs new tokens. Kid-less tokens are still verified with JWT_ACCESS_SECRET.
# Rotate: add the new kid, switch JWT_ACTIVE_KID, drop the old kid after ACCESS_TOKEN_TTL.
JWT_ACCESS_KEYS=
JWT_ACTIVE_KID=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
TOTP_ISSUER="Where Is My Bus"
# Always true in real deployments (refused false in production).
RATE_LIMIT_ENABLED=true

# ── Infrastructure ───────────────────────────────────────────────────────────
# Optional. Empty = in-process fallbacks (rate limits, live state, pub/sub, jobs, Socket.IO adapter).
# Production without Redis needs SINGLE_INSTANCE=true (the Render Blueprint does this).
REDIS_URL=
# Run jobs inside the API process (development, and single-instance production).
JOBS_IN_PROCESS=true
# true = production may run without REDIS_URL: exactly ONE instance, in-process state (live bus
# positions and rate limits reset on restart). Requires JOBS_IN_PROCESS=true.
SINGLE_INSTANCE=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── Notification channels ────────────────────────────────────────────────────
# ── SMS (parent OTP) — WebPay Services ──
# webpayservices | console  (console = OTPs written to the server log; refused in production)
SMS_PROVIDER=webpayservices
# WebPay Services HTTP API (https). The API key is a secret: never log or commit it.
SMS_API_URL=https://your-webpayservices-host.example.com/api/endpoint
SMS_API_USERNAME=your-webpay-username
SMS_API_KEY=your-webpay-api-key
# DLT-registered sender header (e.g. 6 letters) and route (OTP = the OTP credit route).
SMS_SENDER_ID=ABCDEF
SMS_ROUTE=OTP
# DLT template id (numeric, usually 19 digits) registered for SMS_OTP_MESSAGE.
SMS_DLT_TEMPLATE_ID=1700000000000000000
# Must match the DLT-registered template text EXACTLY; {otp} is replaced by the 6-digit code.
# If it mentions a validity in minutes, keep it equal to SMS_OTP_EXPIRY_MIN (startup warns otherwise).
SMS_OTP_MESSAGE="{otp} is your Where Is My Bus login code. It is valid for 10 minutes. Do not share it."
# OTP policy: expiry 1-30 min, attempts 1-10, resend cooldown 15-600 s, per-phone daily cap 1-100
# (Asia/Kolkata calendar day), global daily circuit breaker on real sends 1-1000000.
SMS_OTP_EXPIRY_MIN=10
SMS_OTP_MAX_ATTEMPTS=5
SMS_OTP_RESEND_SECONDS=60
SMS_OTP_DAILY_CAP=10
SMS_OTP_GLOBAL_DAILY_CAP=2000
# Comma-separated E.164 numbers that receive REAL SMS outside production; every other number gets
# its code printed to the server log instead. In production every number is sent, unless
# SMS_ALLOWLIST_ONLY=true (demo deployments: the allow-list applies in production too).
SMS_DEV_ALLOWED_NUMBERS=
SMS_ALLOWLIST_ONLY=false
# Platform health warns when the OTP-route credit balance (CreditCheck) drops below this.
SMS_LOW_BALANCE_THRESHOLD=500
# Base64 of the Firebase service-account JSON. Empty = push disabled (in-app inbox still works).
FIREBASE_SERVICE_ACCOUNT_B64=
# Optional SMTP; empty SMTP_HOST = emails written to the log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Where Is My Bus <no-reply@example.com>"

# ── Google ───────────────────────────────────────────────────────────────────
# Routes API key for planned route polylines (empty = straight-line fallback, flagged).
GOOGLE_MAPS_SERVER_KEY=

# ── Observability ────────────────────────────────────────────────────────────
# Bearer token of GET /metrics (Prometheus text format: HTTP counters/latency, sockets, jobs, ingest,
# SMS). At least 24 characters without spaces (openssl rand -hex 32). Empty = /metrics answers 404.
METRICS_TOKEN=
# Sentry error reporting for the API and the worker (secrets and personal data are scrubbed).
# Empty = disabled (nothing is sent). https:// required in production. Never reported from tests.
SENTRY_DSN=
# Defaults to NODE_ENV (letters, digits, . - _). Optional release tag, e.g. a git commit sha.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# ── Domain / demo data ───────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Kolkata
PLATFORM_ADMIN_EMAIL=superadmin@example.com
# Initial password for `npm run db:bootstrap` (production first Super Admin; ignored once it exists;
# the admin must change it at first sign-in). Leave empty locally (the dev seed sets its own password).
PLATFORM_ADMIN_INITIAL_PASSWORD=
# Password used by `npm run seed` for demo accounts (dev only). Empty = Wimb@12345 outside production.
SEED_DEFAULT_PASSWORD=
