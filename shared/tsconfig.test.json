{
  // Typecheck of the tests and the vitest config (never emitted; the build uses tsconfig.json).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "vitest.config.ts"],
  "exclude": []
}
