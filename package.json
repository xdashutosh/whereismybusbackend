{
  "name": "whereismybus-backend",
  "version": "2.0.0",
  "private": true,
  "description": "Where Is My Bus — backend (TypeScript, Express 5, PostgreSQL + RLS, Socket.IO, jobs)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "shared:build": "node scripts/build-shared.mjs",
    "postinstall": "node scripts/build-shared.mjs",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "prebuild": "npm run shared:build",
    "build": "tsc -p tsconfig.build.json",
    "start": "NODE_ENV=production node dist/server.js",
    "start:worker": "NODE_ENV=production node dist/worker.js",
    "pretypecheck": "npm run shared:build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "prelint": "npm run shared:build",
    "lint": "eslint .",
    "pretest": "npm run shared:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:status": "tsx src/db/migrate.ts status",
    "seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:setup-roles": "tsx src/db/setupRoles.ts",
    "db:bootstrap": "tsx src/db/bootstrap.ts",
    "release": "node dist/db/migrate.js up && node dist/db/setupRoles.js && node dist/db/bootstrap.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@googlemaps/polyline-codec": "^1.0.28",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/core": "10.75.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "@wimb/shared": "file:./shared",
    "bullmq": "^6.3.16",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "croner": "^10.0.1",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "lru-cache": "^11.5.3",
    "luxon": "^3.7.2",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "otplib": "^13.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "ioredis-mock": "^8.13.1",
    "pino-pretty": "^13.2.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
